<UserControl x:Class="MAAS_SFRThelper.Views.InfluenceMatrixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="GhostWhite"
             d:DesignHeight="700" d:DesignWidth="720">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================================================ -->
        <!-- ROW 0: HEADER                                                    -->
        <!-- ================================================================ -->
        <TextBlock Grid.Row="0" Text="Influence Matrix Extraction"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

        <!-- ================================================================ -->
        <!-- ROW 1: RUN CONTROL (test harness - buttons become real later)    -->
        <!-- ================================================================ -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="Run Test Workload" Width="140" Height="26"
                        Command="{Binding RunTestCommand}" Margin="0,0,8,0"/>
                <Button Content="Cancel" Width="90" Height="26"
                        Command="{Binding CancelCommand}"/>
            </StackPanel>
            <Grid>
                <ProgressBar Height="18" Minimum="0" Maximum="100"
                             Value="{Binding RunProgress.Percent, Mode=OneWay}"/>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="{Binding RunProgress.Percent, StringFormat={}{0:F0}%}"/>
            </Grid>
        </StackPanel>

        <!-- ================================================================ -->
        <!-- ROW 2: RUN LOG                                                   -->
        <!-- ================================================================ -->
        <TextBox Grid.Row="2" IsReadOnly="True"
                 Background="White" Foreground="Black" BorderBrush="LightGray"
                 FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                 Text="{Binding RunProgress.LogText, Mode=OneWay}"
                 TextChanged="LogBox_TextChanged"/>
    </Grid>
</UserControl>