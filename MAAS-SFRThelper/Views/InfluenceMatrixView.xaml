<UserControl x:Class="MAAS_SFRThelper.Views.InfluenceMatrixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="GhostWhite"
             d:DesignHeight="700" d:DesignWidth="720">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================================================ -->
        <!-- ROW 0: HEADER                                                    -->
        <!-- ================================================================ -->
        <TextBlock Grid.Row="0" Text="Influence Matrix Extraction"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

        <!-- ================================================================ -->
        <!-- ROW 1: PLAN ELIGIBILITY                                          -->
        <!-- ================================================================ -->
        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1"
                Background="White" Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Refresh" Width="70" Height="24"
                            Command="{Binding RefreshEligibilityCommand}"/>
                    <TextBlock Text="{Binding EligibilityBanner}" FontWeight="SemiBold"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Firebrick"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BannerStatus}" Value="Pass">
                                        <Setter Property="Foreground" Value="Green"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BannerStatus}" Value="Warn">
                                        <Setter Property="Foreground" Value="DarkOrange"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding EligibilityChecks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                <TextBlock Width="18" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="✗"/>
                                            <Setter Property="Foreground" Value="Firebrick"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Pass">
                                                    <Setter Property="Text" Value="✓"/>
                                                    <Setter Property="Foreground" Value="Green"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Warn">
                                                    <Setter Property="Text" Value="!"/>
                                                    <Setter Property="Foreground" Value="DarkOrange"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           Width="200" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding Detail}" Foreground="Gray"
                                           TextWrapping="Wrap" MaxWidth="420"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ================================================================ -->
        <!-- ROW 2: RUN CONTROL (test harness - buttons become real later)    -->
        <!-- ================================================================ -->
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="Run Test Workload" Width="140" Height="26"
                        Command="{Binding RunTestCommand}" Margin="0,0,8,0"/>
                <Button Content="Test HDF5" Width="90" Height="26"
                        Command="{Binding TestHdfCommand}" Margin="0,0,8,0"/>
                <Button Content="Cancel" Width="90" Height="26"
                        Command="{Binding CancelCommand}"/>
            </StackPanel>
            <Grid>
                <ProgressBar Height="18" Minimum="0" Maximum="100"
                             Value="{Binding RunProgress.Percent, Mode=OneWay}"/>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="{Binding RunProgress.Percent, StringFormat={}{0:F0}%}"/>
            </Grid>
        </StackPanel>

        <!-- ================================================================ -->
        <!-- ROW 3: RUN LOG                                                   -->
        <!-- ================================================================ -->
        <TextBox Grid.Row="3" IsReadOnly="True"
                 Background="White" Foreground="Black" BorderBrush="LightGray"
                 FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                 Text="{Binding RunProgress.LogText, Mode=OneWay}"
                 TextChanged="LogBox_TextChanged"/>
    </Grid>
</UserControl>