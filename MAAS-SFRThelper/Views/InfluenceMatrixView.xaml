<UserControl x:Class="MAAS_SFRThelper.Views.InfluenceMatrixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="GhostWhite"
             d:DesignHeight="760" d:DesignWidth="740">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style x:Key="ParamBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,2,12,2"/>
        </Style>
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,6,2"/>
        </Style>
        <Style x:Key="DeviationNote" TargetType="TextBlock">
            <Setter Property="Foreground" Value="DarkOrange"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================================================ -->
        <!-- ROW 0: HEADER                                                    -->
        <!-- ================================================================ -->
        <TextBlock Grid.Row="0" Text="Influence Matrix Extraction"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

        <!-- ================================================================ -->
        <!-- ROW 1: PLAN ELIGIBILITY                                          -->
        <!-- ================================================================ -->
        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1"
                Background="White" Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Refresh" Width="70" Height="24"
                            Command="{Binding RefreshEligibilityCommand}"/>
                    <TextBlock Text="{Binding EligibilityBanner}" FontWeight="SemiBold"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Firebrick"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BannerStatus}" Value="Pass">
                                        <Setter Property="Foreground" Value="Green"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BannerStatus}" Value="Warn">
                                        <Setter Property="Foreground" Value="DarkOrange"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding EligibilityChecks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                <TextBlock Width="18" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="✗"/>
                                            <Setter Property="Foreground" Value="Firebrick"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Pass">
                                                    <Setter Property="Text" Value="✓"/>
                                                    <Setter Property="Foreground" Value="Green"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Warn">
                                                    <Setter Property="Text" Value="!"/>
                                                    <Setter Property="Foreground" Value="DarkOrange"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           Width="200" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding Detail}" Foreground="Gray"
                                           TextWrapping="Wrap" MaxWidth="420"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ================================================================ -->
        <!-- ROW 2: EXTRACTION PARAMETERS                                     -->
        <!-- ================================================================ -->
        <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="1"
                Background="White" Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Parameters" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource ParamLabel}"
                               Text="Beamlet X (mm)"
                               ToolTip="Beamlet width along leaf travel (mm) at the isocenter plane. Smaller = finer fluence resolution but more beamlets and longer runtime. Default 2.5."/>
                    <TextBox   Grid.Row="0" Grid.Column="1" Style="{StaticResource ParamBox}"
                               ToolTip="Beamlet width along leaf travel (mm) at the isocenter plane. Smaller = finer fluence resolution but more beamlets and longer runtime. Default 2.5."
                               Text="{Binding BeamletSizeX, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource ParamLabel}"
                               Text="Beamlet Y (mm)"
                               ToolTip="Beamlet height (mm). Realized per whole MLC leaves, so effective height follows leaf widths (Millennium central leaves are 5 mm). Default 5."/>
                    <TextBox   Grid.Row="0" Grid.Column="3" Style="{StaticResource ParamBox}"
                               ToolTip="Beamlet height (mm). Realized per whole MLC leaves, so effective height follows leaf widths (Millennium central leaves are 5 mm). Default 5."
                               Text="{Binding BeamletSizeY, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ParamLabel}"
                               Text="Target structure"
                               ToolTip="Beamlets are kept only where they intersect this structure's beam's-eye-view silhouette plus the margin. '(none)' extracts every beamlet inside the jaws: complete, largest, slowest."/>
                    <ComboBox  Grid.Row="1" Grid.Column="1" Width="150" Height="22" Margin="0,2,12,2"
                               HorizontalAlignment="Left"
                               ToolTip="Beamlets are kept only where they intersect this structure's beam's-eye-view silhouette plus the margin. '(none)' extracts every beamlet inside the jaws: complete, largest, slowest."
                               ItemsSource="{Binding TargetStructures}"
                               SelectedItem="{Binding SelectedTarget}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ParamLabel}"
                               Text="Target margin (mm)"
                               ToolTip="Growth of the target silhouette (mm) before beamlet pruning. Peaks near the edge draw dose from just outside the silhouette; 10 mm covers typical lattice sphere radii. Over-inclusion costs runtime only."/>
                    <TextBox   Grid.Row="1" Grid.Column="3" Style="{StaticResource ParamBox}"
                               ToolTip="Growth of the target silhouette (mm) before beamlet pruning. Peaks near the edge draw dose from just outside the silhouette; 10 mm covers typical lattice sphere radii. Over-inclusion costs runtime only."
                               Text="{Binding TargetMarginMM, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource ParamLabel}"
                               Text="Cutoff (Gy/MU)"
                               ToolTip="Sparse-matrix threshold in stored dose units. 0 keeps every nonzero and preserves the exact reconstruction identity (required for adjoint/optimization work). Nonzero shrinks files but drops small entries."/>
                    <TextBox   Grid.Row="2" Grid.Column="1" Style="{StaticResource ParamBox}"
                               ToolTip="Sparse-matrix threshold in stored dose units. 0 keeps every nonzero and preserves the exact reconstruction identity (required for adjoint/optimization work). Nonzero shrinks files but drops small entries."
                               Text="{Binding CutoffValue, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ParamLabel}"
                               Text="Dose scaling factor"
                               ToolTip="Multiplies every stored matrix value after leakage subtraction. Leave at 1 unless you need site-specific scaling; whatever is used is recorded in the dose_units metadata."/>
                    <TextBox   Grid.Row="2" Grid.Column="3" Style="{StaticResource ParamBox}"
                               ToolTip="Multiplies every stored matrix value after leakage subtraction. Leave at 1 unless you need site-specific scaling; whatever is used is recorded in the dose_units metadata."
                               Text="{Binding DoseScalingFactor, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource ParamLabel}"
                               Text="Batch size"
                               ToolTip="Beamlet slot beams computed per dose-calculation call, per field. Larger batches amortize calculation overhead; smaller batches cancel at finer granularity."/>
                    <TextBox   Grid.Row="3" Grid.Column="1" Style="{StaticResource ParamBox}"
                               ToolTip="Beamlet slot beams computed per dose-calculation call, per field. Larger batches amortize calculation overhead; smaller batches cancel at finer granularity."
                               Text="{Binding BatchSize, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource ParamLabel}"
                               Text="Max dose calc retries"
                               ToolTip="Retry attempts per failed dose calculation before the run aborts."/>
                    <TextBox   Grid.Row="3" Grid.Column="3" Style="{StaticResource ParamBox}"
                               ToolTip="Retry attempts per failed dose calculation before the run aborts."
                               Text="{Binding MaxRetry, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource ParamLabel}"
                               Text="Calc model"
                               ToolTip="Photon volume dose model used on the scratch plan. The clinical plan's own model is never changed."/>
                    <ComboBox  Grid.Row="4" Grid.Column="1" Width="150" Height="22" Margin="0,2,12,2"
                               HorizontalAlignment="Left"
                               ToolTip="Photon volume dose model used on the scratch plan. The clinical plan's own model is never changed."
                               ItemsSource="{Binding CalcModels}"
                               SelectedItem="{Binding SelectedCalcModel}"/>
                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource ParamLabel}"
                               Text="Grid size (cm)"
                               ToolTip="Dose calculation grid on the scratch plan (cm). Finer = more voxels (more matrix rows) and longer calculations. Default 0.25."/>
                    <TextBox   Grid.Row="4" Grid.Column="3" Style="{StaticResource ParamBox}"
                               ToolTip="Dose calculation grid on the scratch plan (cm). Finer = more voxels (more matrix rows) and longer calculations. Default 0.25."
                               Text="{Binding GridSizeCM, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="Override machine"
                               ToolTip="Leave blank to use each source beam's own machine. Set this when the source plan's machine is not commissioned on THIS Eclipse (e.g. an imported TrueBeam on an Edge-only research box). Editable - type any machine name."/>
                    <ComboBox Width="130" Height="22" Margin="0,0,12,0" IsEditable="True"
                              HorizontalAlignment="Left"
                              ToolTip="Leave blank to use each source beam's own machine. Set this when the source plan's machine is not commissioned on THIS Eclipse. Editable - type any machine name."
                              ItemsSource="{Binding MachineSuggestions}"
                              Text="{Binding OverrideMachine, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Style="{StaticResource ParamLabel}" Text="Override energy"
                               ToolTip="Leave blank to use each source beam's own energy. If overriding the machine, set an energy string valid on that machine (e.g. 6X, 10X, 6X-FFF)."/>
                    <TextBox Background="White" Foreground="Black" Width="90" Height="22"
                             VerticalContentAlignment="Center"
                             ToolTip="Leave blank to use each source beam's own energy. If overriding the machine, set an energy valid on that machine (e.g. 6X, 10X, 6X-FFF)."
                             Text="{Binding OverrideEnergy, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <TextBlock Style="{StaticResource DeviationNote}"
                           Visibility="{Binding OverrideActive, Converter={StaticResource BoolToVis}}"
                           Text="Machine/energy override active: the influence matrix will reflect the override machine's beam model, not the source plan's. Appropriate for pipeline development; for optimizing a real plan, extract on that plan's own commissioned machine."/>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                    <CheckBox Content="Export full (dense) matrix" Foreground="Black"
                              ToolTip="Also writes the dense per-beam matrix (large files). Needed for the reconstruction/validation test; uncheck for sparse-only exports."
                              IsChecked="{Binding ExportFullMatrix}" Margin="0,0,20,0"/>
                    <TextBlock Style="{StaticResource ParamLabel}" Text="Output root"
                               ToolTip="Run output goes to &lt;root&gt;\&lt;LastName&gt;$&lt;PatientId&gt;\&lt;PlanId&gt;: per-beam H5 + JSON metadata, the optimization voxel grid, and structure masks."/>
                    <TextBox Background="White" Foreground="Black" Width="300" Height="22"
                             VerticalContentAlignment="Center"
                             ToolTip="Run output goes to &lt;root&gt;\&lt;LastName&gt;$&lt;PatientId&gt;\&lt;PlanId&gt;: per-beam H5 + JSON metadata, the optimization voxel grid, and structure masks."
                             Text="{Binding OutputRoot, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <TextBlock Style="{StaticResource DeviationNote}"
                           Visibility="{Binding CutoffDeviates, Converter={StaticResource BoolToVis}}"
                           Text="Cutoff is nonzero: sparse entries at or below this value are dropped, and the exact reconstruction identity will not hold for this export."/>
                <TextBlock Style="{StaticResource DeviationNote}"
                           Visibility="{Binding ScalingDeviates, Converter={StaticResource BoolToVis}}"
                           Text="Dose scaling factor is not 1: stored values are scaled. Downstream consumers must honor the dose_units metadata."/>
            </StackPanel>
        </Border>

        <!-- ================================================================ -->
        <!-- ROW 3: RUN CONTROL                                               -->
        <!-- ================================================================ -->
        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="Calculate Influence Matrix" Width="170" Height="26" FontWeight="SemiBold"
                        Command="{Binding RunExtractionCommand}" Margin="0,0,8,0"/>
                <Button Content="Inspect Output" Width="110" Height="26"
                        Command="{Binding InspectOutputCommand}" Margin="0,0,8,0"/>
                <!-- Test HDF5 removed: native-DLL deployment risk retired
                     (handoff deferred item 3). Smoke-test service retained
                     in Services\HdfSmokeTest.cs for future bring-ups. -->
                <Button Content="Cancel" Width="90" Height="26"
                        Command="{Binding CancelCommand}"/>
            </StackPanel>
            <Grid>
                <ProgressBar Height="18" Minimum="0" Maximum="100"
                             IsIndeterminate="{Binding IsInspecting}"
                             Value="{Binding RunProgress.Percent, Mode=OneWay}"/>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="{Binding RunProgress.Percent, StringFormat={}{0:F0}%}"/>
            </Grid>
        </StackPanel>

        <!-- ================================================================ -->
        <!-- ROW 4: RUN LOG                                                   -->
        <!-- ================================================================ -->
        <TextBox Grid.Row="4" IsReadOnly="True" MinHeight="150"
                 Background="White" Foreground="Black" BorderBrush="LightGray"
                 FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                 Text="{Binding RunProgress.LogText, Mode=OneWay}"
                 TextChanged="LogBox_TextChanged"/>
    </Grid>
</UserControl>
